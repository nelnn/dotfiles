# This is a demo config to showcase some of the most important commands.
# It is meant to be changed and configured, as it is intentionally kept sparse.
# For a (much) more advanced configuration example see my dotfiles:
# https://github.com/FelixKratz/dotfiles

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

sketchybar --bar position=bottom topmost=window height=20 blur_radius=30 color=0xff000000

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Adding Mission Control Space Indicators #####
# Let's add some mission control spaces:
# https://felixkratz.github.io/SketchyBar/config/components#space----associate-mission-control-spaces-with-an-item
# to indicate active and available mission control spaces.

# Rift virtual workspaces (not macOS Mission Control spaces).
for index in $(/opt/homebrew/bin/rift-cli query workspaces | /opt/homebrew/bin/jq -r '.[].index' | sort -nu)
do
  sketchybar --add item "rift.$index" left \
             --set "rift.$index" \
               icon="$((index + 1))" \
               icon.padding_left=7 icon.padding_right=7 \
               background.color=0x40ffffff \
               background.corner_radius=5 background.height=16 \
               label.drawing=off drawing=off \
               click_script="/opt/homebrew/bin/rift-cli execute workspace switch $index"
done

# Rift pushes workspace/window changes; no polling.
sketchybar --add event rift_changed \
           --add item rift_sync left \
           --set rift_sync drawing=off updates=on update_freq=0 \
             script="$PLUGIN_DIR/rift_workspaces.sh" \
           --subscribe rift_sync rift_changed

##### Adding Left Items #####
# We add some regular items to the left side of the bar, where
# only the properties deviating from the current defaults need to be set

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Status items refresh on events or clicks, never periodic polling.
# More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add item clock right \
           --set clock update_freq=0 icon= script="$PLUGIN_DIR/clock.sh" \
           --subscribe clock mouse.clicked system_woke \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=0 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

# CPU snapshot on click; no background sampling.
sketchybar --add item stats right \
           --set stats icon= label.drawing=off script="$PLUGIN_DIR/cpu.sh" \
             popup.background.color=0xff151515 \
             popup.background.border_color=0xff444444 \
             popup.background.border_width=1 popup.background.corner_radius=6 \
           --subscribe stats mouse.clicked mouse.exited.global \
           --add item stats.cpu popup.stats \
           --set stats.cpu icon.drawing=off label="Click to sample CPU" \
             label.font="Menlo:Regular:12" label.padding_left=12 label.padding_right=12

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update

