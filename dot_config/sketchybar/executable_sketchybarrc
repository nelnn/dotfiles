#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Matrix: phosphor green on near-black.
sketchybar --bar position=bottom topmost=window height=20 blur_radius=0 \
  color=0xff000800 border_width=0 margin=0 y_offset=0 corner_radius=0 \
  padding_left=0 padding_right=0

default=(
  padding_left=2
  padding_right=2
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=0xff00ff41
  label.color=0xff00ff41
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

# Rift virtual workspaces (not macOS Mission Control spaces).
for index in $(/opt/homebrew/bin/rift-cli query workspaces | /opt/homebrew/bin/jq -r '.[].index' | sort -nu)
do
  sketchybar --add item "rift_sep.$index" left \
             --set "rift_sep.$index" icon="|" icon.font="SF Mono:Regular:12.0" \
               icon.color=0xff008822 icon.padding_left=2 icon.padding_right=2 \
               label.drawing=off drawing=off \
             --add item "rift.$index" left \
             --set "rift.$index" \
               icon="$((index + 1))" \
               icon.font="SF Mono:Regular:12.0" \
               icon.padding_left=2 icon.padding_right=2 \
               background.drawing=off \
               label.drawing=off drawing=off \
               click_script="/opt/homebrew/bin/rift-cli execute workspace switch $index"
done

# Rift pushes workspace/window changes; no polling.
sketchybar --add event rift_changed \
           --add item rift_sync left \
           --set rift_sync drawing=off updates=on update_freq=0 \
             script="$PLUGIN_DIR/rift_workspaces.sh" \
           --subscribe rift_sync rift_changed

# Always launch btop in a new Ghostty instance/window.
sketchybar --add item btop right \
           --set btop icon= label.drawing=off \
             click_script="open -na Ghostty --args -e /opt/homebrew/bin/btop"

# Initialise workspace visibility.
sketchybar --update
