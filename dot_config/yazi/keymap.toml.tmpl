#:schema https://yazi-rs.github.io/schemas/keymap.json

{{ include ".chezmoitemplates/profiles/core/.config/yazi/keymap.toml" }}

[[mgr.prepend_keymap]]
on = [ "g", "q" ]
run = "plugin git-root-quit"
desc = "Quit into Git project root"

[[mgr.prepend_keymap]]
on = [ "u", "a" ]
run = "plugin yamb -- save"
desc = "Add hovered file/directory to favourites"

[[mgr.prepend_keymap]]
on = [ "u", "g" ]
run = "plugin yamb -- jump_by_key"
desc = "Open favourites"

[[mgr.prepend_keymap]]
on = [ "u", "G" ]
run = "plugin yamb -- jump_by_fzf"
desc = "Fuzzy-find favourite"

[[mgr.prepend_keymap]]
on = [ "u", "d" ]
run = "plugin yamb -- delete_by_key"
desc = "Delete favourite"

[[mgr.prepend_keymap]]
on = [ "u", "r" ]
run = "plugin yamb -- rename_by_key"
desc = "Rename favourite"
